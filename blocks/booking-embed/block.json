		"title": { "type": "string", "default": "Varaa henkilökohtainen palveluaika" },
		"description": { "type": "string", "default": "Valitse sopiva aika Lahden tehtaanmyymälään tai Helsingin myymälään. Saat asiantuntijan avuksesi ja voit kokeilla sänkyjä rauhassa." },
		"embedUrl": { "type": "string", "default": "https://app.easybook.fi/kalenteri/4a9e462c-0fa4-42ca-97fb-3d889c8df412/T5lThDYC1WfJPd7QgARx" },
		"embedHeight": { "type": "number", "default": 640 },
