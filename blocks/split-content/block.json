{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sankyartesaanit/split-content",
	"title": "Sänkyartesaanit - Jaettu sisältö",
	"category": "sankyartesaanit",
	"icon": "align-pull-left",
	"description": "Teksti ja kuva vierekkäin. Toistettava osio.",
	"textdomain": "kansleri-sankyartesaanit",
	"attributes": {
		"eyebrow": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"paragraphs": { "type": "array", "default": [] },
		"listItems": { "type": "array", "default": [] },
		"imageId": { "type": "number", "default": 0 },
		"imageUrl": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"imagePosition": { "type": "string", "default": "right" },
		"theme": { "type": "string", "default": "default" }
	},
	"supports": {
		"html": false,
		"align": ["full", "wide"],
		"customClassName": false,
		"multiple": true
	},
	"style": "kansleri-sa-frontend",
	"editorScript": "kansleri-sa-editor"
}
